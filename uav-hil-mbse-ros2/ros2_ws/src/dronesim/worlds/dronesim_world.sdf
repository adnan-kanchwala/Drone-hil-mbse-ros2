<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="dronesim_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Obstacle Box 1 (Spaced 2.3m from spawn) -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>-2.0 1.1 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.5 0.7 0.9 1</ambient><diffuse>0.5 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 2 (Bottom-Right Path Obstacle) -->
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>2.1 -1.3 0.5 0 0 -0.2</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.5 0.7 0.9 1</ambient><diffuse>0.5 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 3 (North Wall Obstacle) -->
    <model name="obstacle_box_3">
      <static>true</static>
      <pose>0.3 2.7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.4 0.45 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.4 0.45 1.0</size></box></geometry>
          <material><ambient>0.5 0.7 0.9 1</ambient><diffuse>0.5 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual Green Floor Marker: Waypoint 1 (-3.5, 2.2) -->
    <model name="goal_marker_1">
      <static>true</static>
      <pose>-3.5 2.2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual Green Floor Marker: Waypoint 2 (3.5, -2.4) -->
    <model name="goal_marker_2">
      <static>true</static>
      <pose>3.5 -2.4 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual Green Floor Marker: Waypoint 3 (0.5, 4.2) -->
    <model name="goal_marker_3">
      <static>true</static>
      <pose>0.5 4.2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual Yellow Floor Marker: Home Origin (0.0, 0.0) -->
    <model name="goal_marker_home">
      <static>true</static>
      <pose>0.0 0.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone with 360-Degree 2D Range Sensor -->
    <model name="quadrotor_drone">
      <pose>0 0 0.4 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <visual name="body">
          <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="drone_lidar" type="ray">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <pose>0 0 0.06 0 0 0</pose>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>36</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>5.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
            <ros><remapping>~/out:=scan</remapping></ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>base_link</frame_name>
          </plugin>
        </sensor>
      </link>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros><remapping>cmd_vel:=cmd_vel</remapping></ros>
        <update_rate>20</update_rate>
        <publish_odom>true</publish_odom>
      </plugin>
    </model>
  </world>
</sdf>